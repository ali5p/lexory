# --- LLM (Cloud LLM: groq + GROQ_API_KEY; local dev: ollama + --profile local-llm) ---
# LLM_PROVIDER=ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=120
GROQ_STRUCTURED_OUTPUT=1

# Auth: generate a persistent secret with `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
JWT_SECRET=
JWT_ALGORITHM=HS256
AUTH_COOKIE_SECURE=true
REDIS_URL=redis://localhost:6379/0

# Google OAuth2 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OLLAMA_MODEL=qwen2.5:1.5b-instruct
# OLLAMA_STRUCTURED_OUTPUT=0
# OLLAMA_TIMEOUT=120

# For uvicorn on the host with backends in Docker (published ports), use localhost:
# OLLAMA_URL only when LLM_PROVIDER=ollama (ignored for groq).
# OLLAMA_URL=http://localhost:11434/api/generate
QDRANT_URL=http://localhost:6333
LANGUAGETOOL_URL=http://localhost:8010
# Runtime app role; use a 32+ character URL-safe secret (for example, token_urlsafe(32)).
LEXORY_APP_DB_PASSWORD=
APP_DATABASE_URL=postgresql+asyncpg://lexory_app:${LEXORY_APP_DB_PASSWORD}@localhost:5432/lexory
DATABASE_URL=postgresql+asyncpg://lexory:lexory@localhost:5432/lexory
# In Docker, if DATABASE_URL uses localhost (e.g. from this file), it is rewritten to
# POSTGRES_HOST (default postgres). docker-compose.yml also sets DATABASE_URL to @postgres:5432.

# docker-compose.yml sets QDRANT_URL / OLLAMA_URL / LANGUAGETOOL_URL / DATABASE_URL
# to service names for the lexory container — it does not use these localhost values.

# Include answer keys on /submit exercises for Swagger/manual testing (never enable in prod UI).
LEXORY_EXPOSE_EXERCISE_ANSWERS=1

# Browser origins for the web app (Cloudflare Pages + local Vite).
LEXORY_CORS_ORIGINS=http://localhost:5173,https://your-app.pages.dev
